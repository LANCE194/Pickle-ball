# Everything is optional. With no .env at all, `npm start` just works (database file: data/dinknest.db).
PORT=4000
DATABASE_FILE=data/dinknest.db
STORAGE_DIR=data/storage
TZ=Asia/Manila

# ---- Tenant hosts ----
# Comma-separated hostnames that should resolve to the existing/default club in production.
# For the Render API service, include its hostname, e.g. dinknest-api.onrender.com.
DEFAULT_CLUB_HOSTS=
# Keep disabled until all tenant data and realtime paths are isolated and verified.
MULTICLUB_ENABLED=false
# Required for generated club links. Set only after wildcard DNS and HTTPS routing are ready.
CLUB_SUBDOMAIN_BASE_DOMAIN=
CLUB_SUBDOMAIN_WILDCARD_READY=false

# ---- Cross-origin frontend (production deployment) ----
# Exact Vercel origin, without a trailing slash, e.g. https://dinknest.vercel.app.
CLIENT_ORIGIN=

# ---- Access ----
# Random string. The Super Admin login page lives at /<SUPER_ADMIN_PATH> (server) - set VITE_SUPER_ADMIN_PATH to the same value in client/.env
SUPER_ADMIN_PATH=change-me-to-a-long-random-string
# If SUPER_ADMIN_EMAIL is set and no Super Admin exists, one is created at start. A random password is printed ONCE (or use the variable below).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=
SUPER_ADMIN_IP_ALLOWLIST=
SUPER_ADMIN_SECOND_FACTOR=totp
# Set to "none" to disable the Super Admin authenticator requirement.
TOTP_ISSUER=DinkNest

# ---- Demo data (development only) ----
SEED_DEMO_DATA=false

# ---- Email (optional; when empty, emails are printed to the console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DinkNest <no-reply@dinknest.local>"

# ---- SMS (optional; Twilio trial accounts have limited, verified-recipient delivery) ----
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set either a Twilio sender number or Messaging Service SID.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ---- Advanced ----
# SKIP_BUILD=true   do not build the web app automatically
# DEV=true          same as `npm run dev`
